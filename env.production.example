# Application
APP_NAME="Maraba Hospital"
APP_ENV=production
APP_KEY=base64:ie6KQU1gL7JABCJ5EP3kTFzXJc5VZopOpflmjP0JfC0=                  # generate with: php artisan key:generate --show, paste result here
APP_DEBUG=false
APP_URL=https://marabahospital.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Africa/Lagos

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database — use Render's managed Postgres/MySQL connection string,
# NOT "db" (that only exists inside docker-compose networks).
# Render gives you an external hostname when you provision a database.
DB_CONNECTION=mysql
DB_HOST=your-render-db-external-hostname.render.com
DB_PORT=3306
DB_DATABASE=maraba
DB_USERNAME=maraba
DB_PASSWORD=your_real_db_password

# If you provisioned Render Redis, use its external hostname here.
# If you did NOT provision Redis, switch these three to "database"
# or "file" instead — don't point at a host that doesn't exist.
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
# REDIS_HOST=your-render-redis-external-hostname.render.com
# REDIS_PASSWORD=your_real_redis_password
# REDIS_PORT=6379

SESSION_LIFETIME=120
SANCTUM_STATEFUL_DOMAINS=marabahospital.onrender.com

# Mail (SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@marabahospital.onrender.com
MAIL_FROM_NAME="Maraba Hospital"

# Monnify Payment Gateway
MONNIFY_API_KEY=your_real_monnify_api_key
MONNIFY_SECRET_KEY=your_real_monnify_secret_key
MONNIFY_CONTRACT_CODE=your_real_contract_code
MONNIFY_ENVIRONMENT=LIVE

# Cloudinary
SWITCH_TO_CLOUDINARY=true
CLOUDINARY_CLOUD_NAME=your_real_cloud_name
CLOUDINARY_API_KEY=your_real_api_key
CLOUDINARY_API_SECRET=your_real_api_secret

VITE_APP_NAME="${APP_NAME}"
